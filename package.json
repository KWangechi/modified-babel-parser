{
  "name": "@kwangechi/modified-babel-parser",
  "version": "1.1.0",
  "description": "A modified version of @babel/parser to support JSX ::propA shorthand syntax",
  "author": "Rachel Karanja (https://github.com/KWangechi)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "babel",
    "javascript",
    "parser",
    "jsx",
    "shorthand"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/KWangechi/modified-babel-parser.git"
  },
  "main": "./index.cjs",
  "module": "./lib/index.js",
  "types": "./typings/babel-parser.d.ts",
  "exports": {
    ".": {
      "require": "./index.cjs",
      "import": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc --version && rollup -c"
  },
  "files": [
    "bin",
    "lib",
    "typings/babel-parser.d.ts",
    "index.cjs"
  ],
  "engines": {
    "node": ">=6.0.0"
  },
  "dependencies": {
    "@babel/types": "^7.27.1"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "charcodes": "^0.2.0",
    "rollup": "^4.40.1"
  },
  "bin": "./bin/babel-parser.js",
  "type": "module"
}
